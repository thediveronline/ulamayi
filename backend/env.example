# Copie ce fichier en .env et remplis les valeurs reelles
# =============================================================================
# ATTENTION : ne jamais committer de vraies valeurs de secrets ici.
# Ce fichier est public sur GitHub, il ne doit contenir que des placeholders.

# --- Connexion PostgreSQL (2 options) ---
# Option A : URL complete (recommande pour Neon.tech / base externe)
# DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/neondb?sslmode=require

# Option B : Variables separees (dev local avec PostgreSQL installe sur la machine)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ulamayi
# DB_USER=ulamayi
# DB_PASSWORD=ton_mot_de_passe

# --- JWT ---
JWT_SECRET=remplace_par_une_phrase_aleatoire_longue

# --- Mailgun (envoi des OTP par email) ---
# Si absent : le code OTP sera affiche dans la console du serveur (dev)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Ulamayi <noreply@mg.mondomaine.com>
MAILGUN_REGION=eu

# --- Cloudinary (upload des medias des publications) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OTP ---
OTP_EXPIRES_MINUTES=10

# --- Serveur ---
PORT=3000
